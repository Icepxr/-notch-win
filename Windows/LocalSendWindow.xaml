<!-- Local customization: additive send window; existing notch layouts are unchanged. -->
<Window x:Class="VNotch.LocalSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="Send via LocalSend" Width="480" MinWidth="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#F2F2F2" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False" Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <!-- Match SpotlightPreferencesDialog: neutral surfaces, white action, 12px controls. -->
    <SolidColorBrush x:Key="Muted" Color="#A0A0A0"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#D8DEE5"/>
      <Setter Property="BorderBrush" Value="#2B2B2B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="42"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="SelectionBrush" Value="#555555"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#505050"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B8B8B8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#303030"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B8B8B8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="#F2F2F2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" CornerRadius="14" BorderThickness="1" BorderBrush="#2B2B2B" Background="#101010" Padding="{TemplateBinding Padding}">
          <ContentPresenter/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#505050"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#707070"/><Setter TargetName="Row" Property="Background" Value="#1B1B1B"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#F2F2F2"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="SendSurface" Background="#000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="24" Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="FILE TRANSFER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
          <TextBlock Text="Send via LocalSend" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>
        <Button Grid.Column="1" Width="32" Height="32" MinHeight="32" Padding="0" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Top" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close send window">
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#B8B8B8"/>
        </Button>
      </Grid>
      <TextBlock Grid.Row="1" Text="Keep LocalSend open on your iPad and use the same Wi-Fi." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/>
      <Border Grid.Row="2" Background="#101010" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A0A0A0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock x:Name="FileSummary" FontWeight="SemiBold"/><TextBlock x:Name="FileNames" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="3" MinHeight="80">
        <ListBox x:Name="Devices" MaxHeight="180" Background="Transparent" BorderThickness="0" SelectionChanged="Devices_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Nearby LocalSend devices">
          <ListBox.ItemTemplate><DataTemplate><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#A0A0A0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyDevices" Text="Looking for nearby devices…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False"/>
      </Grid>
      <Grid Grid.Row="4" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><Label Content="Device IP" Target="{Binding ElementName=IpAddress}" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/><TextBox x:Name="IpAddress" ToolTip="LocalSend → Settings → IP address" AutomationProperties.Name="Device IP address"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0"><Label Content="Port" Target="{Binding ElementName=DevicePort}" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/><TextBox x:Name="DevicePort" Text="53317" MaxLength="5" AutomationProperties.Name="Device port"/></StackPanel>
        <Button x:Name="Connect" Grid.Column="2" Content="Connect" VerticalAlignment="Bottom" Click="Connect_Click"/>
      </Grid>
      <StackPanel x:Name="PinPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,12,0,0">
        <Label Content="Receiver PIN" Target="{Binding ElementName=ReceiverPin}" Foreground="{StaticResource Muted}" Padding="0,0,0,5"/>
        <PasswordBox x:Name="ReceiverPin" MaxLength="32" AutomationProperties.Name="Receiver PIN"/>
      </StackPanel>
      <StackPanel Grid.Row="6" Margin="0,14,0,14">
        <ProgressBar x:Name="TransferProgress" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="#F2F2F2" Background="#262626" BorderThickness="0" AutomationProperties.Name="Transfer progress"/>
        <TextBlock x:Name="Status" Text="Select a device, or connect using its local IP address." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <Border Grid.Row="7" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid>
        <Button x:Name="Refresh" Content="Refresh" HorizontalAlignment="Left" Click="Refresh_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelTransfer" Content="Cancel" Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click"/>
          <Button x:Name="Send" Content="Send files" Background="#F2F2F2" Foreground="#101010" BorderBrush="#F2F2F2" IsEnabled="False" Click="Send_Click"/>
        </StackPanel>
      </Grid></Border>
    </Grid>
  </Border>
</Window>
