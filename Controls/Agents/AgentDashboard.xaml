<!-- Local customization: a native notch page, sharing the upstream shell and fonts. -->
<UserControl x:Class="VNotch.Controls.Agents.AgentDashboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Foreground="#F2F2F2" FontSize="13" UseLayoutRounding="True" Background="Transparent"
 IsVisibleChanged="Visibility_Changed" Loaded="Dashboard_Loaded" Unloaded="Dashboard_Unloaded"
 PreviewMouseWheel="Dashboard_Wheel" MouseLeftButtonDown="Dashboard_MouseDown">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AgentProviderMarks.xaml"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="AgentMuted" Color="#A0A0A0"/>
   <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="5"/><Setter Property="MinWidth" Value="5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
     <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="#505050"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
     </Track></Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="Button">
    <Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="#D8DEE5"/>
    <Setter Property="BorderBrush" Value="#303030"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="AgentCard" TargetType="Border">
    <Setter Property="Background" Value="#101010"/><Setter Property="BorderBrush" Value="#2B2B2B"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="14"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="AI Agent" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button x:Name="RefreshLimits" Grid.Column="1" Content="Refresh limits" Click="Refresh_Click" ToolTip="Check account limits using your installed CLIs. No AI message is sent." AutomationProperties.Name="Refresh agent account limits"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ReadStatus" Text="Reading local activity…" Foreground="{StaticResource AgentMuted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button x:Name="Today" Content="Today" Tag="1" Click="Period_Click" Padding="9,5" Background="#F2F2F2" Foreground="#101010" AutomationProperties.Name="Show today's agent activity"/>
    <Button x:Name="Week" Content="7d" Tag="7" Click="Period_Click" Padding="9,5" Margin="4,0,0,0" AutomationProperties.Name="Show seven days of agent activity"/>
    <Button x:Name="Month" Content="30d" Tag="30" Click="Period_Click" Padding="9,5" Margin="4,0,0,0" AutomationProperties.Name="Show thirty days of agent activity"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="AgentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
   <StackPanel>
    <ItemsControl x:Name="Providers" HorizontalContentAlignment="Stretch">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource AgentCard}" Margin="0,0,10,0">
       <StackPanel>
        <Grid Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Image Source="{Binding Mark}" Width="26" Height="26" HorizontalAlignment="Left"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{StaticResource AgentMuted}" FontSize="10" VerticalAlignment="Center"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding Windows}"><ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,0,0,8" ToolTip="{Binding Observed}">
          <Grid>
           <TextBlock Text="{Binding Name}" Foreground="{StaticResource AgentMuted}" FontSize="12" VerticalAlignment="Center"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text=" left" FontSize="11" Foreground="{StaticResource AgentMuted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel>
          </Grid>
          <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Remaining, Mode=OneWay}" Foreground="#D8DEE5" Background="#303030" BorderThickness="0" Margin="0,4,0,5" Visibility="{Binding BarVisibility}" AutomationProperties.Name="{Binding AccessibleValue}"/>
          <TextBlock Text="{Binding Reset}" Foreground="{StaticResource AgentMuted}" FontSize="11" TextWrapping="Wrap"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <StackPanel Visibility="{Binding EmptyVisibility}" Margin="0,0,0,12">
         <TextBlock Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,4"/>
         <TextBlock Text="{Binding Status}" Foreground="{StaticResource AgentMuted}" TextWrapping="Wrap" FontSize="12" MinHeight="32"/>
         <Button Content="Copy sign-in command" Tag="{Binding Name}" Click="CopyLogin_Click" Margin="0,8,0,0" Visibility="{Binding LoginVisibility}" ToolTip="Copy a terminal command. Complete sign-in yourself; no credentials are read by this page."/>
        </StackPanel>
        <Border BorderBrush="#303030" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Observed tokens" Foreground="{StaticResource AgentMuted}" FontSize="11"/><TextBlock Text="{Binding Tokens}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
         <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="Responses" Foreground="{StaticResource AgentMuted}" FontSize="11"/><TextBlock Text="{Binding Responses}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Right"/></StackPanel>
        </Grid></Border>
        <TextBlock Text="{Binding Note}" Foreground="{StaticResource AgentMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Margin="0,18,10,10"><TextBlock Text="Activity" FontWeight="SemiBold"/><TextBlock x:Name="ActivityCount" Foreground="{StaticResource AgentMuted}" FontSize="12" HorizontalAlignment="Right"/></Grid>
    <TextBlock x:Name="EmptyActivity" Text="Open Claude Code or Codex on this PC to see local activity." Foreground="{StaticResource AgentMuted}" TextWrapping="Wrap" Margin="0,0,10,12"/>
    <ItemsControl x:Name="Sessions"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#101010" CornerRadius="12" Padding="12,10" Margin="0,0,10,6">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Image Source="{Binding Mark}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource AgentMuted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{StaticResource AgentMuted}" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="3" Text="Local records ≠ plan allowance · Nothing is sent to AI chat" Foreground="{StaticResource AgentMuted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
